# Gerçek Sistem verisi görünür sekmede bu aralıkla otomatik yenilenir.
# Değer tarayıcı paketine gömülür; en az 30000 olmalıdır. Geçersiz değer 60000'e döner.
NEXT_PUBLIC_MERGEN_ROTA_AUTO_REFRESH_INTERVAL_MS=60000
NEXT_PUBLIC_MERGEN_ROTA_PUBLIC_BASE_PATH=/rota

# SQL Server settings are server-only. Never rename these with NEXT_PUBLIC_*.
# MERGEN Rota uses Windows Integrated Authentication. The Windows account that
# runs the Node.js process must be granted access to the database by IT.
MERGEN_ROTA_DB_SERVER=sqlserver.example.internal
MERGEN_ROTA_DB_PORT=1433
MERGEN_ROTA_DB_DATABASE=MERGEN_Rota
MERGEN_ROTA_DB_ODBC_DRIVER=ODBC Driver 18 for SQL Server
MERGEN_ROTA_DB_ENCRYPT=true
MERGEN_ROTA_DB_TRUST_SERVER_CERTIFICATE=true
MERGEN_ROTA_DB_CONNECTION_TIMEOUT_MS=15000
MERGEN_ROTA_DB_REQUEST_TIMEOUT_MS=30000

# Corporate WBS source (CN43N). The table lives in a DIFFERENT database than
# MERGEN_Rota, so it needs its own connection. Leave SERVER/DATABASE empty to
# disable the synchronization: corporate projects then show only their root node.
# Windows Integrated Authentication is used here as well.
MERGEN_ROTA_WBS_DB_SERVER=
MERGEN_ROTA_WBS_DB_PORT=1433
MERGEN_ROTA_WBS_DB_DATABASE=
MERGEN_ROTA_WBS_DB_SCHEMA=dbo
MERGEN_ROTA_WBS_DB_TABLE=CN43N
MERGEN_ROTA_WBS_DB_ODBC_DRIVER=ODBC Driver 18 for SQL Server
MERGEN_ROTA_WBS_DB_ENCRYPT=true
MERGEN_ROTA_WBS_DB_TRUST_SERVER_CERTIFICATE=false
MERGEN_ROTA_WBS_DB_CONNECTION_TIMEOUT_MS=15000
MERGEN_ROTA_WBS_DB_REQUEST_TIMEOUT_MS=60000
# Project codes fetched from CN43N per round trip during synchronization.
MERGEN_ROTA_WBS_SYNC_PROJECT_BATCH=50
# Freshness window for the corporate catalog refresh (projects + CN43N WBS).
# Within this window a snapshot request performs no corporate synchronization at
# all. Set to 0 to synchronize on every request (development and tests).
MERGEN_ROTA_WBS_SYNC_TTL_MS=300000

# ─────────────────────────────────────────────────────────────────────────────
# Authentication (Keycloak). Server-only: never rename these with NEXT_PUBLIC_*.
# MERGEN Rota runs on port 8008. MERGEN Bilge (a separate application) uses 8009.
# ─────────────────────────────────────────────────────────────────────────────
# keycloak (default, production) | development (local only, see below)
MERGEN_ROTA_AUTH_MODE=keycloak
# Login flow. Exactly one of:
#   authorization-code (default, preferred) — Authorization Code + PKCE. The
#     access token never reaches the browser; the server exchanges the code.
#     A confidential Keycloak client requires valid client authentication at the
#     token endpoint for this exchange to succeed.
#   implicit-bridge (compatibility) — for a Keycloak client that already works
#     with the browser implicit flow. The token endpoint is NOT used and no
#     client secret is required. The browser receives the access token in the URL
#     fragment for a moment, the fragment is removed immediately, the token is
#     posted once to MERGEN Rota, and the server performs the full JWT + Sicil
#     validation before writing the usual HttpOnly session cookie.
# An unknown value is a configuration error: MERGEN Rota does not fall back.
# MERGEN_ROTA_KEYCLOAK_FLOW=authorization-code
# Accepts either the server address or the full realm issuer URL.
MERGEN_ROTA_KEYCLOAK_BASE_URL=https://<KEYCLOAK_HOST>
MERGEN_ROTA_KEYCLOAK_REALM=<REALM>
MERGEN_ROTA_KEYCLOAK_CLIENT_ID=<CLIENT_ID>
# Required only when the selected client/flow needs confidential-client
# authentication. Public clients use PKCE and implicit-bridge never uses the
# token endpoint, so both leave this empty.
# MERGEN_ROTA_KEYCLOAK_CLIENT_SECRET=
# Expected `aud`. Defaults to the client id when empty. Separate with ; or ,
MERGEN_ROTA_KEYCLOAK_AUDIENCE=
# Expected `azp`. Defaults to the client id when empty.
MERGEN_ROTA_KEYCLOAK_AUTHORIZED_PARTY=
# Authorization Code + PKCE callback. Belongs to that flow only.
MERGEN_ROTA_KEYCLOAK_REDIRECT_URI=
# Implicit bridge callback. Used only by MERGEN_ROTA_KEYCLOAK_FLOW=implicit-bridge.
# When empty it is derived from the current request origin, but production must
# supply an explicit URI that matches the Keycloak client registration exactly.
# MERGEN_ROTA_KEYCLOAK_IMPLICIT_REDIRECT_URI=https://<MERGEN_ROTA_HOST>:8008/auth/implicit-callback
MERGEN_ROTA_KEYCLOAK_POST_LOGOUT_REDIRECT_URI=https://<MERGEN_HOST>/rota/
MERGEN_ROTA_KEYCLOAK_SCOPE=openid profile email
# Optional JWKS override. Derived from the realm issuer when empty.
MERGEN_ROTA_KEYCLOAK_JWKS_URL=
MERGEN_ROTA_KEYCLOAK_JWKS_CACHE_TTL_MS=600000
# Rate limit for the extra JWKS refresh triggered by an unknown `kid`.
MERGEN_ROTA_KEYCLOAK_JWKS_MIN_REFRESH_MS=30000
# Accepted signing algorithms. RS256 only unless the realm is configured otherwise.
MERGEN_ROTA_KEYCLOAK_ALLOWED_ALGORITHMS=RS256
MERGEN_ROTA_KEYCLOAK_CLOCK_TOLERANCE_SECONDS=30
# When the verified token has no `sicil` claim, resolve
# preferred_username -> HR02 corporate username -> Sicil (must be unique).
MERGEN_ROTA_KEYCLOAK_USERNAME_SICIL_FALLBACK=true
# Masked identity diagnostics only. Raw tokens and full claims are never logged.
MERGEN_ROTA_AUTH_DEBUG=true

# Application session cookie (HttpOnly). Generate a long random value, e.g.
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
MERGEN_ROTA_SESSION_SECRET=<LONG_RANDOM_SECRET>
MERGEN_ROTA_SESSION_TTL_SECONDS=28800
# Keep true in production. Set to false only for plain-HTTP local development.
MERGEN_ROTA_SESSION_COOKIE_SECURE=true

# Local development identity. Works ONLY together with
# MERGEN_ROTA_AUTH_MODE=development. Never enable in production, and never use
# it as a fallback when a Keycloak flow fails.
MERGEN_ROTA_DEV_IDENTITY_ENABLED=false
MERGEN_ROTA_DEV_SICIL=

# ─────────────────────────────────────────────────────────────────────────────
# Direct HTTP test of the implicit bridge on port 8008 (placeholders only).
# Put real values in the uncommitted .env.local, never here.

# NOT (24.08.2026): PR #57 sonrasında authorization-code etkinleştirildiğinde
# önce redirect_uri hatası görüldü. Authorization Code callback adresi Keycloak
# kaydıyla eşleştirildiğinde bu aşama geçti; ancak token endpoint'i HTTP 401
# unauthorized_client / "Invalid client or Invalid client credentials" döndürdü.
# Tanılama, mevcut Keycloak istemcisinin confidential-client kimlik doğrulaması
# beklediğini ve uygulamada client secret bulunmadığını doğruladı. Keycloak BT
# ekibi client secret sağlamadıkça veya istemciyi public + PKCE olarak
# değiştirmedikçe çalışan uyumluluk kipi implicit-bridge olarak tutulmalıdır.
MERGEN_ROTA_KEYCLOAK_FLOW=implicit-bridge
MERGEN_ROTA_KEYCLOAK_CLIENT_SECRET=
MERGEN_ROTA_KEYCLOAK_IMPLICIT_REDIRECT_URI=https://<MERGEN_HOST>/rota/auth/implicit-callback
MERGEN_ROTA_SESSION_COOKIE_SECURE=true

# MERGEN_ROTA_SESSION_COOKIE_SECURE=false is ONLY acceptable for that plain-HTTP
# test: a browser will not store a Secure cookie over http://. Production must
# use HTTPS and keep MERGEN_ROTA_SESSION_COOKIE_SECURE=true.
#
# NODE_EXTRA_CA_CERTS may still be required in both flows: the server keeps
# fetching the realm JWKS to verify the access token signature. Set it in the
# environment before Node starts; never commit the certificate path.
# ─────────────────────────────────────────────────────────────────────────────

# ─────────────────────────────────────────────────────────────────────────────
# Corporate user photographs.
# NOT A SECRET: this value is read by the browser and is inlined into the client
# bundle, which is why it carries the NEXT_PUBLIC_ prefix. The photo URL is built
# as <BASE_URL>/<SICIL>.jpg. Keep the real internal address in .env.local only;
# .env.local is git-ignored and must not be committed. When the value is empty
# every avatar falls back to initials.
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_MERGEN_ROTA_USER_PHOTO_BASE_URL=https://<INTERNAL_PHOTO_HOST>/<PHOTO_PATH>

# Optional live SQL Server test switch. Default CI must leave this disabled.
MERGEN_ROTA_DB_INTEGRATION=0

# ─────────────────────────────────────────────────────────────────────────────
# Görev hatırlatma e-postaları (SMTP). Sunucu tarafıdır: bu değişkenlerin
# hiçbiri NEXT_PUBLIC_ ile yeniden adlandırılmamalıdır — kullanıcı adı ve parola
# istemci paketine ASLA girmez. Gerçek değerler yalnızca git tarafından yok
# sayılan .env.local dosyasında bulunur.
#
# SMTP_HOST ve SMTP_FROM boş bırakılırsa posta gönderimi kapalıdır: arayüz
# bunu açıkça söyler ve hiçbir zaman "gönderildi" demez.
# ─────────────────────────────────────────────────────────────────────────────
# Outlook veya elle/otomatik hatırlatma kullanılıyorsa SMTP_HOST ve geçerli SMTP_FROM zorunludur.
# SMTP yalnızca iki işlev de kullanılmıyorsa isteğe bağlıdır; yoksa davetler kuyrukta kalır.
SMTP_HOST=smtp.example.internal
SMTP_PORT=587
SMTP_USERNAME=<SMTP_KULLANICI>
SMTP_PASSWORD=<SMTP_PAROLA>
SMTP_FROM=mergen-rota@example.internal
SMTP_FROM_NAME=MERGEN Rota
# Kurumsal sunucu 587 üzerinde STARTTLS bekler (bkz. docs/TASK-REMINDERS.md).
SMTP_USE_STARTTLS=true
# Kurumsal kök sertifikayı NODE_EXTRA_CA_CERTS ile tanıtın; doğrulamayı kapatmayın.
SMTP_TLS_REJECT_UNAUTHORIZED=true
SMTP_TIMEOUT_MS=20000

# Otomatik hatırlatma zamanlayıcısının anahtarı; Outlook çalışanı bunu kullanmaz.
# Uzun rastgele bir değer üretin:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# Boş bırakılırsa /api/mergen-rota/reminders/run YALNIZCA sistem yöneticisi
# oturumuyla çalıştırılabilir; hiçbir koşulda kimliksiz erişime açılmaz.
MERGEN_ROTA_REMINDER_CRON_SECRET=<UZUN_RASTGELE_DEGER>

# Kurumsal kullanıcı dizini tablosu. MERGEN Rota veritabanının İÇİNDEDİR
# (MERGEN_ROTA_DB_DATABASE) ve yalnızca OKUNUR: e-posta adresleri görev
# kayıtlarına kopyalanmaz. Varsayılanlar kurumsal şemayla uyumludur.
# Hem görev hatırlatmaları hem Outlook takvim davetleri bu tek kaynağı kullanır.
MERGEN_ROTA_USER_DIRECTORY_SCHEMA=dbo
MERGEN_ROTA_USER_DIRECTORY_TABLE=DC01_userr

# ─────────────────────────────────────────────────────────────────────────────
# Outlook takvim tümleştirmesi (kurum içi SMTP + iCalendar).
#
# Microsoft Graph, Entra ID ve EWS KULLANILMAZ; internet erişimi gerekmez.
# Davetler yukarıdaki SMTP ayarlarıyla, kurum içi posta sunucusu üzerinden
# gönderilir. Bu bölümdeki değişkenlerin hiçbiri gizli bilgi değildir ama
# hiçbiri NEXT_PUBLIC_ ile yeniden adlandırılmamalıdır: tümü sunucu tarafıdır.
# Ayrıntı: docs/OUTLOOK-CALENDAR.md
# ─────────────────────────────────────────────────────────────────────────────
# Özelliği tümüyle kapatır (varsayılan açık). Kapalıyken uçlar 403 döner ve
# arayüz eylemi devre dışı, nedeni açık biçimde gösterir.
# Geçersiz açık değer güvenli biçimde kapalı kabul edilir.
MERGEN_ROTA_OUTLOOK_CALENDAR_ENABLED=true
# Node sunucusuyla başlayan Outlook çalışanının turlar arası beklemesi (1000-60000 ms).
# Hatırlatma ayarından bağımsızdır; Outlook için OS zamanlayıcısı gerekmez.
MERGEN_ROTA_OUTLOOK_POLL_INTERVAL_MS=5000
# Tek istekte Outlook'a eklenebilecek en çok görev sayısı (1-50).
MERGEN_ROTA_OUTLOOK_BULK_LIMIT=25
# Zamanlanmış turda tek seferde işlenecek bekleyen teslimat sayısı (1-200).
MERGEN_ROTA_OUTLOOK_OUTBOX_BATCH=25
# Kuyruk sağlık hatası bildirilecek deneme eşiği (1-20).
# Eşik aşılınca gönderim durmaz; en çok bir saat arayla yeniden denenir.
# Kullanıcının açık eylemi sayacı sıfırlar.
MERGEN_ROTA_OUTLOOK_MAX_ATTEMPTS=6
# Outlook kuyruk bütçesi (1000-240000 ms); süre dolunca SMTP kesilir.
# Otomatik bağlantı edinme +15 sn; her sonuç/hata yazımı bağımsız +5 sn (varsayılan toplam en çok 70 sn).
MERGEN_ROTA_OUTLOOK_RUN_BUDGET_MS=45000

# Takvim bağlantısının kökeni; /rota yolunu eklemeyin.
# Üretimde https:// zorunludur. Düz http:// yalnız localhost, 127.0.0.1 veya [::1]
# geliştirme kökenlerinde kabul edilir; uzak HTTP/bozuk değer sunucuda
# OUTLOOK_PUBLIC_ORIGIN_INVALID yapılandırma hatası olarak kaydedilir.
# Yol öneki NEXT_PUBLIC_MERGEN_ROTA_PUBLIC_BASE_PATH ile eklenir.
# Otomatik/elle tanı turlarında bu değer yoksa bağlantı eklenmez.
MERGEN_ROTA_PUBLIC_ORIGIN=https://<MERGEN_HOST>

# Açılış ekranının sol üst kurum logosu: sunucunun okuyabildiği SVG dosyası.
# UNC/Windows yolu desteklenir. Node hizmet hesabına paylaşımda okuma yetkisi verin.
# Örnek: \\dosya-sunucusu\paylasim\Logolar\white\kurum.svg
# Ayar değişikliğinden sonra uygulamayı yeniden başlatın; dosya yolu tarayıcıya gönderilmez.
MERGEN_ROTA_COMPANY_LOGO_PATH=
# Eski ayar da desteklenir: HTTPS adresi veya UNC SVG yolu. Yeni kurulumda yukarıdaki ayarı kullanın.
NEXT_PUBLIC_MERGEN_ROTA_COMPANY_LOGO_URL=
