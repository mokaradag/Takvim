# SQL Server settings are server-only. Never rename these with NEXT_PUBLIC_*.
# MERGEN Rota uses Windows Integrated Authentication. The Windows account that
# runs the Node.js process must be granted access to the database by IT.
MERGEN_ROTA_DB_SERVER=sqlserver.example.internal
MERGEN_ROTA_DB_PORT=1433
MERGEN_ROTA_DB_DATABASE=MERGEN_Rota
MERGEN_ROTA_DB_ODBC_DRIVER=ODBC Driver 18 for SQL Server
MERGEN_ROTA_DB_ENCRYPT=true
MERGEN_ROTA_DB_TRUST_SERVER_CERTIFICATE=false
MERGEN_ROTA_DB_CONNECTION_TIMEOUT_MS=15000
MERGEN_ROTA_DB_REQUEST_TIMEOUT_MS=30000

# Corporate WBS source (CN43N). The table lives in a DIFFERENT database than
# MERGEN_Rota, so it needs its own connection. Leave SERVER/DATABASE empty to
# disable the synchronization: corporate projects then show only their root node.
# Windows Integrated Authentication is used here as well.
MERGEN_ROTA_WBS_DB_SERVER=
MERGEN_ROTA_WBS_DB_PORT=1433
MERGEN_ROTA_WBS_DB_DATABASE=
MERGEN_ROTA_WBS_DB_SCHEMA=dbo
MERGEN_ROTA_WBS_DB_TABLE=CN43N
MERGEN_ROTA_WBS_DB_ODBC_DRIVER=ODBC Driver 18 for SQL Server
MERGEN_ROTA_WBS_DB_ENCRYPT=true
MERGEN_ROTA_WBS_DB_TRUST_SERVER_CERTIFICATE=false
MERGEN_ROTA_WBS_DB_CONNECTION_TIMEOUT_MS=15000
MERGEN_ROTA_WBS_DB_REQUEST_TIMEOUT_MS=60000
# Project codes fetched from CN43N per round trip during synchronization.
MERGEN_ROTA_WBS_SYNC_PROJECT_BATCH=50
# Freshness window for the corporate catalog refresh (projects + CN43N WBS).
# Within this window a snapshot request performs no corporate synchronization at
# all. Set to 0 to synchronize on every request (development and tests).
MERGEN_ROTA_WBS_SYNC_TTL_MS=300000

# Temporary pre-Keycloak integration identity. Disabled by default.
MERGEN_ROTA_DEV_IDENTITY_ENABLED=false
MERGEN_ROTA_DEV_SICIL=

# Optional live SQL Server test switch. Default CI must leave this disabled.
MERGEN_ROTA_DB_INTEGRATION=0
