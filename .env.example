# SQL Server settings are server-only. Never rename these with NEXT_PUBLIC_*.
MERGEN_ROTA_DB_SERVER=sqlserver.example.internal
MERGEN_ROTA_DB_PORT=1433
MERGEN_ROTA_DB_DATABASE=MERGEN_Rota
MERGEN_ROTA_DB_USER=replace-me
MERGEN_ROTA_DB_PASSWORD=replace-me
MERGEN_ROTA_DB_ENCRYPT=true
MERGEN_ROTA_DB_TRUST_SERVER_CERTIFICATE=false
MERGEN_ROTA_DB_CONNECTION_TIMEOUT_MS=15000
MERGEN_ROTA_DB_REQUEST_TIMEOUT_MS=30000

# Temporary pre-Keycloak integration identity. Disabled by default.
MERGEN_ROTA_DEV_IDENTITY_ENABLED=false
MERGEN_ROTA_DEV_SICIL=

# Optional live SQL Server test switch. Default CI must leave this disabled.
MERGEN_ROTA_DB_INTEGRATION=0
